{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file-raw",
        "source": "~/.config/fastfetch/logo2.txt",
        "width": 30,
        "height": 15,
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "white"
        }
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#white}╭─────────────╮"
        },
        {
            "key": "{#white}│ {#blue} User@Com  {#white}│",
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "key": "{#white}│ {#blue} OS        {#white}│",
            "type": "os"
        },
        {
            "key": "{#white}│ {#blue}󰌢 Host      {#white}│",
            "type": "host"
        },
        {
            "key": "{#white}│ {#green}󰅐 Uptime    {#white}│",
            "type": "uptime"
        },
        {
            "key": "{#white}│ {#yellow} Shell     {#white}│",
            "type": "shell"
        },
        {
            "key": "{#white}│ {#yellow} Terminal  {#white}│",
            "type": "terminal"
        },
        {
            "key": "{#white}│ {#yellow}󰍹 Display   {#white}│",
            "type": "display",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "custom",
            "format": "{#white}├─────────────┤"
        },
        {
            "key": "{#white}│ {#magenta}󰻠 CPU       {#white}│",
            "type": "cpu",
            "format": "{name}"
        },
        {
            "key": "{#white}│ {#magenta}󰢮 GPU       {#white}│",
            "type": "gpu",
            "hideType": "integrated",
            "format": "{name}"
        },
        {
            "key": "{#white}│ {#cyan}󰍛 Memory    {#white}│",
            "type": "memory",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "key": "{#white}│ {#cyan}󰉉 Disk (C:) {#white}│",
            "type": "disk",
            "folders": "C:\\",
            "format": "{size-used} / {size-total} ({size-percentage})"
        },
        {
            "key": "{#white}│ {#green}󰁹 Battery   {#white}│",
            "type": "battery",
            "format": "{capacity} [{status}]"
        },
        {
            "key": "{#white}│ {#blue}󰩟 Local IP  {#white}│",
            "type": "localip",
            "format": "{ipv4}"
        },
        {
            "key": "{#white}│ {#green}󰤨 Wi-Fi     {#white}│",
            "type": "wifi",
            "format": "{ssid} ({signal-quality}) - 󰁅 {rx-rate} Mbps / 󰁝 {tx-rate} Mbps"
        },
        {
            "type": "custom",
            "format": "{#white}├─────────────┤"
        },
        {
            "key": "{#white}│ {#magenta} Colors    {#white}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "{#white}╰─────────────╯"
        }
    ]
}